repository-code: "https://github.com/shin4141/decision-os-paper"
url: "https://github.com/shin4141/decision-os-paper"
license: "CC-BY-4.0"
abstract: "Navigation and archival references for Decision-OS research. Paper version numbers, software versions, and the historical gateway release date are separate. Public deposits do not establish peer review or general empirical validation."
keywords:
  - "Decision-OS"
  - "AI Safety"
  - "AGI safety"
  - "Irreversibility"
  - "Risk control"
  - "Auditability"
  - "Zero-knowledge"
  - "Time-Tube"
  - "PIC"
  - "Reconnectable Forgetting"
  - "Completion Integrity"
  - "Compound Loop Governance"
  - "Resource Justice"

